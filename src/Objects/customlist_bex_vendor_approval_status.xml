<customlist scriptid="customlist_bex_vendor_approval_status">
    <name>Vendor Approval Status</name>
    <description>Status values used by the Vendor Approval workflow.</description>
    <isinactive>F</isinactive>
    <isordered>F</isordered>
    <customvalues>
        <customvalue scriptid="customvalue_bex_vend_status_pending">
            <abbreviation>PND</abbreviation>
            <value>Pending</value>
            <isdefault>T</isdefault>
        </customvalue>
        <customvalue scriptid="customvalue_bex_vend_status_approved">
            <abbreviation>APR</abbreviation>
            <value>Approved</value>
            <isdefault>F</isdefault>
        </customvalue>
        <customvalue scriptid="customvalue_bex_vend_status_rejected">
            <abbreviation>REJ</abbreviation>
            <value>Rejected</value>
            <isdefault>F</isdefault>
        </customvalue>
    </customvalues>
</customlist>
